---
// src/pages/blog/index.astro

/**
 * BLOG - Lista de Posts
 * Diseño unificado con el Design System y Layout global
 */

import Layout from '../../components/global/Layout.astro';
import { getServices } from '@server/lib/core/di/ContextFactory';
import { urlFor } from '@server/lib/adapters/cms';
import type { PostSummary, Category } from '@server/lib/features/blog/Blog.entity';

// Obtener parámetros de URL
const url = new URL(Astro.request.url);
const categoryFilter = url.searchParams.get('category') || undefined;
const page = parseInt(url.searchParams.get('page') || '1');
const limit = 9;
const offset = (page - 1) * limit;

// Obtener datos
const { blogService } = getServices();

let posts: PostSummary[] = [];
let totalPosts = 0;
let categories: Category[] = [];

try {
  const [postsResult, cats] = await Promise.all([
    Promise.all([
      blogService.listPosts({ limit, offset, category: categoryFilter }),
      blogService.countPosts({ category: categoryFilter }),
    ]),
    blogService.listCategories(),
  ]);
  
  [posts, totalPosts] = postsResult;
  categories = cats;
} catch (e) {
  console.warn('[Blog] Error cargando posts de Sanity:', e);
}

const totalPages = Math.ceil(totalPosts / limit);

// Helper para formatear fecha
function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('es-ES', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout 
  title="Blog y Guías de Visas de Turismo"
  description="Guías actualizadas, consejos prácticos y noticias para tramitar tu visa de turismo a Estados Unidos, Canadá, Schengen y más."
>
  <div class="bg-surface-light min-h-screen py-12 md:py-20">
    <div class="container-main">
      <!-- Header de la Sección -->
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="badge-pill bg-brand-secondary/10 text-brand-secondary mb-4">
          Recursos y Consejos
        </span>
        <h1 class="text-3xl md:text-5xl font-bold text-text-primary tracking-tight mb-4">
          Blog de Visas y Viajes
        </h1>
        <p class="text-lg text-text-secondary font-light">
          Aprende todo lo necesario para preparar tu solicitud con éxito y sin errores.
        </p>
      </div>

      <!-- Filtros por categoría -->
      {categories.length > 0 && (
        <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
          <a 
            href="/blog" 
            class={`badge-pill text-sm font-semibold transition-all ${!categoryFilter ? 'bg-brand-secondary text-white shadow-md' : 'bg-white text-text-secondary hover:bg-slate-100 border border-slate-200'}`}
          >
            Todos
          </a>
          {categories.map((cat) => (
            <a 
              href={`/blog?category=${cat.slug}`}
              class={`badge-pill text-sm font-semibold transition-all ${categoryFilter === cat.slug ? 'bg-brand-secondary text-white shadow-md' : 'bg-white text-text-secondary hover:bg-slate-100 border border-slate-200'}`}
            >
              {cat.title}
            </a>
          ))}
        </div>
      )}

      <!-- Grid de Posts -->
      {posts.length === 0 ? (
        <div class="card-base text-center py-16 px-4 max-w-md mx-auto">
          <p class="text-text-secondary text-lg mb-4">No hay artículos disponibles por el momento.</p>
          {categoryFilter && (
            <a href="/blog" class="inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-brand-secondary text-white text-sm font-semibold hover:bg-brand-accent transition-colors">
              Ver todos los artículos
            </a>
          )}
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
          {posts.map((post) => (
            <article class="card-base card-hover overflow-hidden flex flex-col group">
              <a href={`/blog/${post.slug}`} class="flex-1 flex flex-col">
                {post.featuredImage && (
                  <div class="w-full h-52 overflow-hidden bg-slate-100">
                    <img 
                      src={urlFor(post.featuredImage).width(600).height(350).url()} 
                      alt={post.featuredImage.alt || post.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                )}
                <div class="p-6 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class="text-xs font-semibold text-brand-secondary">
                        {post.category.title}
                      </span>
                      {post.readingTime && (
                        <span class="text-xs text-text-muted">{post.readingTime} min</span>
                      )}
                    </div>
                    <h2 class="text-xl font-bold text-text-primary leading-snug group-hover:text-brand-secondary transition-colors mb-3">
                      {post.title}
                    </h2>
                    {post.excerpt && (
                      <p class="text-sm text-text-secondary leading-relaxed line-clamp-3 mb-4">
                        {post.excerpt}
                      </p>
                    )}
                  </div>
                  <div class="flex items-center justify-between pt-4 border-t border-slate-100 text-xs text-text-muted">
                    <span class="font-medium text-text-secondary">{post.author.name}</span>
                    <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      )}

      <!-- Paginación -->
      {totalPages > 1 && (
        <div class="flex items-center justify-center gap-4">
          {page > 1 && (
            <a 
              href={`/blog?page=${page - 1}${categoryFilter ? `&category=${categoryFilter}` : ''}`}
              class="px-5 py-2 rounded-full border border-slate-200 bg-white text-sm font-medium hover:bg-slate-50 transition-colors"
            >
              ← Anterior
            </a>
          )}
          <span class="text-sm text-text-muted">
            Página {page} de {totalPages}
          </span>
          {page < totalPages && (
            <a 
              href={`/blog?page=${page + 1}${categoryFilter ? `&category=${categoryFilter}` : ''}`}
              class="px-5 py-2 rounded-full border border-slate-200 bg-white text-sm font-medium hover:bg-slate-50 transition-colors"
            >
              Siguiente →
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</Layout>
